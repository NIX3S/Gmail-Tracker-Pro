{
    "manifest_version": 3,
    "name": "Gmail Tracker Pro",
    "version": "2.1",
    "description": "Suivi d'ouverture et de clics pour les emails envoyés depuis Gmail, avec option de document tracké transparent.",
    "permissions": ["storage", "activeTab"],
    "host_permissions": ["https://mail.google.com/*","http://127.0.0.1:8000/*"],
    "optional_host_permissions": ["http://*/*", "https://*/*"],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["https://mail.google.com/*"],
            "js": ["content.js"]
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "options_page": "options.html"
}
